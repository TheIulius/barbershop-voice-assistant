# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- LLM: choose "gemini" (free key, easiest) or "ollama" (local, open-source) ---
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# For LLM_PROVIDER=ollama (after installing Ollama and pulling a model)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Calendar: "local" (JSON file, works immediately) or "google" ---
CALENDAR_BACKEND=local
# For google: service-account JSON path. Each barber needs their own calendar
# shared with the service account's email ("Make changes to events"), and the
# calendar ID put in data/shop.json -> barbers -> calendar_id.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Dev-only page section listing bookings (no login!). Set 0 for anything public.
DEBUG_UI=1

# Optional: separate (often faster/better) model for speech-to-text. Test: 3.5-flash answered in ~2 s.
# GEMINI_STT_MODEL=gemini-3.5-flash
# Free-tier quotas run out per model; each call falls back along these lists automatically.
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview
# GEMINI_STT_FALLBACK_MODELS=gemini-flash-lite-latest

# Voice tuning (Microsoft voices via edge-tts). Rate like +30% is faster, -10% slower.
# TTS_RATE=+22%
# TTS_VOICE_KA=ka-GE-GiorgiNeural

# Max live calls per IP per 10 minutes (protects your free quota / wallet). 12 is a sane public default.
# LIVE_MAX_CALLS_10MIN=12
